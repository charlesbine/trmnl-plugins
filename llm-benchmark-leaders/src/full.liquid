{% if leaderboard %}
  {% assign models = data %}
{% else %}
  {% assign models = data | where: "gpqa_score" | sort: "gpqa_score" | reverse %}
{% endif %}
<style>
  .benchmark-table {
    align-self: flex-start;
    width: 100%;
    table-layout: fixed;
  }
  .benchmark-table:has(tbody tr:nth-child(8)) {
    --table-tbody-height: auto;
    height: 100%;
  }
  .benchmark-table th:first-child { width: 28%; }
  .benchmark-table th:nth-child(2) { width: 15%; }
  .benchmark-table th:nth-child(3) { width: 14%; }
  .benchmark-table th:nth-child(5) { width: 13%; }
  .benchmark-table .label, .benchmark-table .title {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  @container (max-width: 660px) {
    .benchmark-table .benchmark-detail { display: none; }
    .benchmark-table th:first-child { width: 56%; }
    .benchmark-table th:nth-child(5) { width: auto; }
  }
  @container (max-height: 880px) {
    .benchmark-table tbody tr:nth-child(n+17) { display: none; }
  }
  @container (max-height: 650px) {
    .benchmark-table tbody tr:nth-child(n+13) { display: none; }
  }
  @container (max-height: 460px) {
    .benchmark-table tbody tr:nth-child(n+9) { display: none; }
  }
</style>
<div class="layout">
  <table class="table benchmark-table">
    <thead>
      <tr>
        <th><span class="title">Model</span></th>
        <th class="benchmark-detail"><span class="title">Org</span></th>
        <th class="benchmark-detail"><span class="title">Release</span></th>
        <th><span class="title">{{ leaderboard.short_label | default: "GPQA" | escape }}</span></th>
        <th><span class="title">Context</span></th>
        <th class="benchmark-detail"><span class="title">Input</span></th>
        <th class="benchmark-detail"><span class="title">Output</span></th>
      </tr>
    </thead>
    <tbody>
      {% for model in models limit: 20 %}
      <tr>
        <td><span class="label">{{ model.name | escape }}</span></td>
        <td class="benchmark-detail"><span class="label">{{ model.organization | escape }}</span></td>
        <td class="benchmark-detail"><span class="label">{{ model.release_date | default: "—" | escape }}</span></td>
        <td>
          <span class="label">
            {% if model.score_display %}
              {{ model.score_display | escape }}
            {% else %}
              {{ model.gpqa_score | times:100 | round:1 }}%
            {% endif %}
          </span>
        </td>
        <td><span class="label">{% if model.context %}{{ model.context | divided_by:1000 }} k{% else %}—{% endif %}</span></td>
        <td class="benchmark-detail">
          <span class="label">
            {% if model.input_price %}$ {{ model.input_price | round: 2 }}{% else %}—{% endif %}
          </span>
        </td>
        <td class="benchmark-detail">
          <span class="label">
            {% if model.output_price %}$ {{ model.output_price | round: 2 }}{% else %}—{% endif %}
          </span>
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>

<div class="title_bar">
  <img class="image" src="https://trmnl.com/images/plugins/trmnl--render.svg" />
  <span class="title">{% if leaderboard.rotating %}Daily Benchmark{% else %}LLM Benchmark Leaders{% endif %}</span>
  <span class="instance">{{ leaderboard.label | default: "GPQA Diamond" }} · {{ leaderboard.capability | default: "Graduate-Level Reasoning" }}</span>
</div>
